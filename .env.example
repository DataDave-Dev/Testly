LLM_API_KEY=                         # API key del proveedor del modelo (secreto)
LLM_MODEL=claude-sonnet-5             # Modelo usado para generar las pruebas
LLM_EFFORT=medium                     # Nivel de razonamiento: low, medium o high

TURSO_DATABASE_URL=                   # URL de la base de datos Turso
TURSO_AUTH_TOKEN=                     # Token de acceso a Turso (secreto)
BETTER_AUTH_SECRET=                   # Secreto para firmar sesiones (secreto)
RESEND_API_KEY=                       # API key para enviar magic links (secreto)
TURNSTILE_SECRET_KEY=                 # Secreto de validación anti-bot (secreto)

MAX_CODE_CHARS=12000                  # Máximo de caracteres de código recibido
LLM_MAX_OUTPUT_TOKENS=16000           # Máximo de tokens que puede generar el modelo
QUOTA_ANONIMA_DIARIA=3                # Generaciones diarias sin sesión, por IP
QUOTA_PER_PERIOD=10                   # Generaciones por 30 días con sesión

MAINTENANCE_MODE=true                 # Activa la pantalla de mantenimiento
MAINTENANCE_BYPASS_SECRET=            # Secreto para que el equipo pueda entrar
LAUNCH_DATE=2026-12-01T00:00:00-06:00 # Fecha de lanzamiento del contador
